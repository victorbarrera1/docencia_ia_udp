# ==============================================================================
# CONFIGURACIÓN DE ENTORNO — MICROSERVICIO AGENTE IA UDP (agent-services)
# ==============================================================================

# Entorno y Servidor
ENVIRONMENT=development
PORT=8080
HOST=0.0.0.0
APP_NAME="Docencia IA UDP - Agent Services"

# Proveedor de Inteligencia Artificial Unificado (OpenRouter - Guía Maestra)
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
DEFAULT_OPENROUTER_MODEL=openrouter/auto
ACTIVITY_DESIGNER_MODEL=anthropic/claude-3.5-haiku

# Evaluador de entregas (IA-08): modelo abierto. Producción: Qwen servido con vLLM en la UDP.
# EVALUATOR_BASE_URL vacío = OpenRouter (con EVALUATOR_API_KEY u OPENROUTER_API_KEY). Con un endpoint propio
# solo se usa EVALUATOR_API_KEY (puede ir vacía): la llave de OpenRouter nunca viaja a otro host.
# Un servidor propio no informa costo: ai_audit_log guarda costo NULL y los tokens igual.
EVALUATOR_MODEL=qwen/qwen3.8-27b
# EVALUATOR_BASE_URL=https://llm.udp.example/v1
EVALUATOR_BASE_URL=
EVALUATOR_API_KEY=
EVALUATOR_TIMEOUT_S=120
EVALUATOR_MAX_TOKENS=4000
# Entregas de hasta N mil caracteres van completas; más largas, por fragmentos RAG por criterio
EVALUATOR_MAX_TEXT_KCHARS=48
EVALUATOR_RAG_TOP_K=3
# Citas más cortas se descartan (no son evidencia verificable)
EVALUATOR_MIN_CITA_CHARS=8
# Proporción del puntaje que equivale a 4,0 (escala 1,0–7,0)
EVALUATOR_EXIGENCIA=0.6

# Embeddings vía OpenRouter. Deben coincidir con el contrato de la migración IA-04.
# Cambiar modelo o dimensión exige migrar rag_chunks.embedding y regenerar el índice.
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
# Textos por llamada a /embeddings (cada lote queda auditado como una llamada)
EMBEDDING_BATCH_SIZE=32
# Indexar en segundo plano cada versión recién subida (si falla, POST /api/v1/rag/backfill la recoge)
RAG_AUTO_INDEX=1

# Modelo del chat jerárquico (/api/v1/agent/chat), vía OpenRouter y auditado en ai_audit_log (IA-07)
CHAT_MODEL=google/gemini-2.5-flash

# Registro auditable del uso de IA (IA-07). Escribe en ai_audit_log con SUPABASE_SERVICE_ROLE_KEY.
# Solo guarda metadatos (modelo, tokens, costo); nunca prompts ni respuestas.
AI_AUDIT_ENABLED=1
# Tope de la escritura en línea; si se excede, la llamada de IA sigue y el fallo queda en logs
AI_AUDIT_TIMEOUT_S=3

# DEPRECADO (IA-07): el chat ya no llama a Gemini directo; usa OpenRouter con CHAT_MODEL.
# Estas variables y google-genai se retirarán cuando se coordine con el frontend.
GEMINI_API_KEY=tu_gemini_api_key_aqui
DEFAULT_FRONTIER_MODEL=gemini-2.5-flash
DEFAULT_WORKER_MODEL=gemini-2.5-flash

# Presupuestos y Seguridad Agéntica
MAX_STEPS_PER_TURN=5
MAX_TOKENS_BUDGET=4000

# Base de Datos y Persistencia (Supabase pgvector)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Ingesta de PDF (IA-05): bucket privado creado por la migración 20261106_ingesta_pdf.sql
SUBMISSION_BUCKET=entregas
MAX_PDF_MB=20
MAX_PDF_PAGES=300
MAX_PDF_TEXT_KCHARS=1500
CHUNK_CHARS=3200
CHUNK_OVERLAP_CHARS=400

# Integración Canvas LMS UDP
CANVAS_BASE_URL=https://udp.instructure.com
CANVAS_API_TOKEN=tu_token_canvas_aqui

# Cliente LLM robusto (IA-03)
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_S=0.5
# LLM_FAKE=1 devuelve respuestas deterministas sin llamar a OpenRouter (CI y desarrollo offline)
LLM_FAKE=
# Qué usa response_format json_schema estricto: prefijos de modelo o de endpoint (p. ej. el vLLM de la UDP)
LLM_JSON_SCHEMA_MODELS=openai/,google/,qwen/,deepseek/
